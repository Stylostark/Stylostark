# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=clothing_wholesale
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Phone OTP (Twilio - Optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Admin Configuration
ADMIN_EMAIL=admin@clothing-wholesale.com
ADMIN_PASSWORD=admin_secure_password_change_this

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads/
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Global Marketplace Settings
DEFAULT_MOQ=12
DEFAULT_GST_RATE=18

# Session Configuration
SESSION_SECRET=your_session_secret_key_change_this
SESSION_TIMEOUT=3600000
